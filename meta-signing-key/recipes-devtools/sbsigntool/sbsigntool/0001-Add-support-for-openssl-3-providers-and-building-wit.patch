 		"\t--cert <certfile>  certificate (x509 certificate)\n"
@@ -455,7 +469,14 @@ int main(int argc, char **argv)
 
 	for (;;) {
 		int idx;
-		c = getopt_long(argc, argv, "o:g:a:k:c:ivVhe:", options, &idx);
+		c = getopt_long(argc, argv, "o:g:a:k:c:ivVh"
+#ifndef OPENSSL_NO_ENGINE
+				"e:"
+#endif
+#if OPENSSL_VERSION_MAJOR >= 3
+				"p:"
+#endif
+				, options, &idx);
 		if (c == -1)
 			break;
 
@@ -487,9 +508,16 @@ int main(int argc, char **argv)
 		case 'h':
 			usage();
 			return EXIT_SUCCESS;
+#ifndef OPENSSL_NO_ENGINE
 		case 'e':
 			engine = optarg;
 			break;
+#endif
+#if OPENSSL_VERSION_MAJOR >= 3
+		case 'p':
+			OSSL_PROVIDER_load(NULL, optarg);
+			break;
+#endif
 		}
 	}
 

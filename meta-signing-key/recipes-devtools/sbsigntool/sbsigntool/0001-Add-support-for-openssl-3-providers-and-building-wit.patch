 };
 
@@ -409,7 +418,12 @@ void usage(void)
 			"<var-name> <var-data-file>\n"
 		"Sign a blob of data for use in SetVariable().\n\n"
 		"Options:\n"
+#ifndef OPENSSL_NO_ENGINE
 		"\t--engine <eng>     use the specified engine to load the key\n"
